{
  "name": "freetheai",
  "version": "0.1.1",
  "description": "Official JavaScript and TypeScript SDK for FreeTheAI, the free OpenAI-compatible AI API: chat, streaming, tool calls, web search, image and video tasks, with built-in retries, fallback models, and rate-limit handling.",
  "keywords": [
    "freetheai",
    "free ai api",
    "openai compatible",
    "llm",
    "ai sdk",
    "chat completions",
    "streaming",
    "tool calls",
    "web search",
    "typescript",
    "fetch",
    "free llm api"
  ],
  "homepage": "https://free-the-ai.github.io/freetheai-js/",
  "bugs": {
    "url": "https://github.com/Free-The-Ai/freetheai-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Free-The-Ai/freetheai-js.git"
  },
  "license": "MIT",
  "author": {
    "name": "Vibhek Soni",
    "email": "vibheksoni@engineer.com",
    "url": "https://vibheksoni.com"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.19.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^3.1.1"
  }
}
